{
  "name": "musicpulse",
  "version": "1.0.0",
  "description": "MusicPulse - music analytics platform",
  "author": "MusicPulse",
  "private": true,
  "type": "module",
  "main": "electron.cjs",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder"
  },

  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },

  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  },

  "build": {
    "appId": "com.musicpulse.app",
    "productName": "MusicPulse",

    "directories": {
      "output": "release"
    },

    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },

    "win": {
      "icon": "build/windows/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
